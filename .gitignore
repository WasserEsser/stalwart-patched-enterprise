# Extracted Stalwart binaries used for offline probing/analysis
stalwart-*
stalwartlabs-*

# IDA Pro database files
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
*.idb

# Generated license keys and local test configs
# *.key is the Ed25519 private key that signs licenses: never commit it. Losing
# it means rebuilding the patched image from the official one with a new key
# pair (patch.sh only replaces the vendor key, so it cannot re-key in place).
*.key
stalwart-license.key
/tmp/

# Local test artifacts
/data/
